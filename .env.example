# Copy to `.env` next to docker-compose.yml and adjust.
# Apart from the administrator, every value below is also the default.

# The administrator, created on the first start of an empty instance — required then, ignored after.
# It signs in with the username. Remove the password from this file once the instance is up.
NOTKA_ADMIN_USERNAME=admin
NOTKA_ADMIN_PASSWORD=
# Optional; lets others share notes with the administrator.
NOTKA_ADMIN_EMAIL=

# The address people reach the instance at. Password-reset links are built from it.
NOTKA_PUBLIC_URL=https://notes.example.com

# Sign-in through an OpenID Connect provider such as Pocket ID, next to passwords. Register the callback
# <NOTKA_PUBLIC_URL>/api/auth/sso/callback at the provider. Leave NOTKA_OIDC_ISSUER empty to use passwords
# only, and NOTKA_OIDC_CLIENT_SECRET empty for a public client.
NOTKA_OIDC_ISSUER=
NOTKA_OIDC_CLIENT_ID=
NOTKA_OIDC_CLIENT_SECRET=
NOTKA_OIDC_NAME=SSO

# Outgoing mail for password resets, configured like Vaultwarden's. Leave NOTKA_SMTP_HOST empty to
# send nothing (the administrator can then still delete accounts, but not reset passwords).
# NOTKA_SMTP_SECURITY: starttls (port 587), force_tls (465) or off (25).
NOTKA_SMTP_HOST=
NOTKA_SMTP_SECURITY=starttls
NOTKA_SMTP_PORT=
NOTKA_SMTP_USERNAME=
NOTKA_SMTP_PASSWORD=
NOTKA_SMTP_FROM=notka@example.com
NOTKA_SMTP_FROM_NAME=Notka

# Host address and port the app is published on. Loopback by default: put a TLS-terminating
# reverse proxy on the same host in front of it (deploy/Caddyfile.example).
NOTKA_BIND=127.0.0.1
NOTKA_HTTP_PORT=8080

# The session cookie is only sent over HTTPS (browsers make an exception for localhost).
NOTKA_COOKIE_SECURE=true

# Believe the reverse proxy's X-Forwarded-For; the sign-in rate limit is keyed by the client address.
# Only safe while the port above is reachable by the proxy alone.
NOTKA_TRUST_PROXY_HEADERS=true

# Ceiling on how many notes one account may own, trash included.
NOTKA_MAX_NOTES_PER_USER=10000

# Picture storage of the notes one account owns, in MB.
NOTKA_MAX_IMAGE_STORAGE_MB=1024

# Memory ceiling of the container; the JVM takes 75% of it for its heap.
NOTKA_MEMORY_LIMIT=512m

# How long a login lasts (extended on every request).
NOTKA_SESSION_TTL_DAYS=30

# How long a trashed note is kept before it is purged for good.
NOTKA_TRASH_RETENTION_DAYS=30

# Maximum size of a single note document, in bytes.
NOTKA_MAX_NOTE_BYTES=65536

# Logback root level: TRACE, DEBUG, INFO, WARN, ERROR.
NOTKA_LOG_LEVEL=INFO

# Start as a demo instance: two sample accounts (Alice is the administrator), their notes, and the
# accounts offered on the sign-in screen. Seeds only an empty database, and the passwords are public — never point it at
# anything you care about.
DEMO=false
